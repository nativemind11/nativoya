rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Group chat — one document per group, messages as a subcollection.
    // Regular members/leaders can only read/write their OWN group's chat
    // (matched by the groupId custom claim baked into their Firebase token
    // by our backend). head_leader accounts can read/write ANY group, so
    // they can monitor or broadcast from the admin dashboard.
    match /groups/{groupId}/messages/{messageId} {
      allow read: if request.auth != null && (
                     request.auth.token.role == 'head_leader' ||
                     request.auth.token.groupId == groupId
                   );

      allow create: if request.auth != null && (
                       request.auth.token.role == 'head_leader' ||
                       request.auth.token.groupId == groupId
                     )
                     && request.resource.data.senderId == request.auth.uid;

      // messages are never edited or deleted from the client
      allow update, delete: if false;
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
