rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function hasGroupAccess(groupId) {
      return request.auth != null && (
        request.auth.token.role == 'head_leader' ||
        (groupId in request.auth.token.groupIds)
      );
    }

    function isHeadLeader() {
      return request.auth != null && request.auth.token.role == 'head_leader';
    }

    // The group's own document only holds moderation flags — right now just
    // whether the head_leader has "قفل الشات" (locked the chat) for that
    // group. Only a head_leader can create/change it; anyone in the group
    // can read it so their chat UI can show a "مقفول" banner live.
    match /groups/{groupId} {
      allow read: if hasGroupAccess(groupId);
      allow write: if isHeadLeader();
    }

    // Group chat — one document per group, messages as a subcollection.
    // A member/leader can read/write any group THEY belong to (matched
    // against the groupIds array custom claim baked into their Firebase
    // token by our backend, since one user can be in several language
    // groups at once). head_leader accounts can read/write ANY group, so
    // they can monitor or broadcast from the admin dashboard.
    match /groups/{groupId}/messages/{messageId} {
      allow read: if hasGroupAccess(groupId);

      // A head_leader can always send, even while the chat is locked (e.g.
      // to post an announcement about why it's locked). Members/leaders can
      // only send while the group ISN'T locked.
      function isGroupLocked() {
        return exists(/databases/$(database)/documents/groups/$(groupId))
          && get(/databases/$(database)/documents/groups/$(groupId)).data.chatLocked == true;
      }

      allow create: if hasGroupAccess(groupId)
                     && request.resource.data.senderId == request.auth.uid
                     && (isHeadLeader() || !isGroupLocked());

      // A member/leader who belongs to this group (or a head_leader) can
      // update a message ONLY in one of two safe, narrow ways:
      //
      //  1) Editing their OWN message's text — only `text` + `editedAt` may
      //     change, and every other field (senderId, createdAt, type...)
      //     must stay exactly the same. This is what powers "تعديل الرسالة".
      //
      //  2) Reacting to ANY message in the group — only the `reactions` map
      //     may change, and within it only the KEY matching their own uid
      //     may change (add/replace/remove their own emoji). Nobody can
      //     touch anyone else's reaction entry this way. This is what
      //     powers "الرياكت" — one emoji per person per message.
      //
      // Deleting is allowed for the original sender, OR a head_leader
      // moderating ANY message in ANY group — that's what powers "مسح
      // الهيد ليدر لأي رسالة حد تاني بعتها".
      function isOwnTextEdit() {
        return resource.data.senderId == request.auth.uid
          && resource.data.type == 'text'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'editedAt']);
      }

      function isOwnReactionChange() {
        let before = ('reactions' in resource.data) ? resource.data.reactions : {};
        let after = request.resource.data.reactions;
        return request.resource.data.diff(resource.data).affectedKeys().hasOnly(['reactions'])
          && after.diff(before).affectedKeys().hasOnly([request.auth.uid]);
      }

      allow update: if hasGroupAccess(groupId) && (isOwnTextEdit() || isOwnReactionChange());

      allow delete: if request.auth != null && (
                      isHeadLeader() ||
                      resource.data.senderId == request.auth.uid
                    );
    }

    // Everything else stays locked down by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
